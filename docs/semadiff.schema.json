{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tpt-solutions/tpt-semadiff/docs/semadiff.schema.json",
  "title": "semadiff --out json",
  "description": "Output of `semadiff --out json`. A single file pair prints one report. Several files (directory or --rev mode) print an envelope with a list. See docs/json-schema.md for the meaning of each field.",
  "oneOf": [
    { "$ref": "#/$defs/report" },
    { "$ref": "#/$defs/envelope" }
  ],
  "$defs": {
    "report": {
      "type": "object",
      "required": ["schema_version", "old_name", "new_name", "language", "engine", "counts", "groups"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "old_name": { "type": "string" },
        "new_name": { "type": "string" },
        "language": { "type": "string" },
        "engine": { "type": "string", "enum": ["chawathe", "zhang-shasha"] },
        "counts": { "$ref": "#/$defs/counts" },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
        "summaries": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "summary_source": { "type": "string", "enum": ["rules", "llm"] },
        "summary_fallback": { "type": "string" }
      }
    },
    "counts": {
      "type": "object",
      "required": ["insert", "delete", "move", "update"],
      "additionalProperties": false,
      "properties": {
        "insert": { "type": "integer", "minimum": 0 },
        "delete": { "type": "integer", "minimum": 0 },
        "move": { "type": "integer", "minimum": 0 },
        "update": { "type": "integer", "minimum": 0 }
      }
    },
    "group": {
      "type": "object",
      "required": ["function", "start_line", "end_line", "changes"],
      "additionalProperties": false,
      "properties": {
        "function": { "type": ["string", "null"] },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } }
      }
    },
    "change": {
      "type": "object",
      "required": ["op", "node_kind", "old_line", "new_line", "description"],
      "additionalProperties": false,
      "properties": {
        "op": { "type": "string", "enum": ["insert", "delete", "move", "update"] },
        "node_kind": { "type": "string" },
        "old_line": { "type": ["integer", "null"], "minimum": 1 },
        "new_line": { "type": ["integer", "null"], "minimum": 1 },
        "description": { "type": "string" }
      }
    },
    "file_error": {
      "type": "object",
      "required": ["old_name", "new_name", "error"],
      "additionalProperties": false,
      "properties": {
        "old_name": { "type": "string" },
        "new_name": { "type": "string" },
        "error": { "type": "string" }
      }
    },
    "envelope": {
      "type": "object",
      "required": ["schema_version", "files"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "files": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/report" },
              { "$ref": "#/$defs/file_error" }
            ]
          }
        }
      }
    }
  }
}
